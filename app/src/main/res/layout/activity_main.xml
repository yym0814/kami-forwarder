<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="卡密转发"
            android:textSize="28sp"
            android:textColor="#333"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="请先登录代理账号"
            android:textSize="14sp"
            android:textColor="#999"
            android:layout_marginBottom="24dp"/>

        <!-- 用户名 -->
        <EditText
            android:id="@+id/et_username"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="代理用户名"
            android:inputType="text"
            android:textSize="14sp"
            android:padding="12dp"
            android:background="#FFF"
            android:singleLine="true"
            android:layout_marginBottom="12dp"/>

        <!-- 密码 -->
        <EditText
            android:id="@+id/et_password"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="代理密码"
            android:inputType="textPassword"
            android:textSize="14sp"
            android:padding="12dp"
            android:background="#FFF"
            android:singleLine="true"
            android:layout_marginBottom="16dp"/>

        <!-- 登录按钮 -->
        <Button
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="登录"
            android:textSize="16sp"
            android:textColor="#FFF"
            android:backgroundTint="#673AB7"
            android:layout_marginBottom="12dp"/>

        <!-- 状态 -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="请填写用户名和密码"
            android:textSize="14sp"
            android:textColor="#FF9800"
            android:gravity="center"
            android:background="#FFF3E0"
            android:layout_marginBottom="16dp"
            android:visibility="gone"/>

        <!-- 已登录状态卡片 -->
        <LinearLayout
            android:id="@+id/card_logged_in"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="16dp"
            android:background="#E8F5E9"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已成功登录"
                android:textSize="16sp"
                android:textColor="#4CAF50"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tv_logged_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="代理账号: --"
                android:textSize="14sp"
                android:textColor="#333"/>

            <TextView
                android:id="@+id/tv_logged_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="推广码: --"
                android:textSize="14sp"
                android:textColor="#333"/>
        </LinearLayout>

        <!-- 测试按钮 -->
        <Button
            android:id="@+id/btn_test"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="测试连接"
            android:textSize="16sp"
            android:textColor="#673AB7"
            android:layout_marginBottom="8dp"
            android:visibility="gone"/>

        <!-- 注销按钮 -->
        <Button
            android:id="@+id/btn_logout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="注销登录"
            android:textSize="16sp"
            android:textColor="#F44336"
            android:layout_marginBottom="8dp"
            android:visibility="gone"/>

        <!-- 通知权限 -->
        <Button
            android:id="@+id/btn_open_settings"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="开启通知监听权限"
            android:textSize="16sp"
            android:textColor="#FFF"
            android:backgroundTint="#E91E63"/>

        <!-- 使用说明 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            android:padding="12dp"
            android:background="#FFF">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="使用说明"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. 输入代理用户名和密码，点击登录\n2. 登录后点击「开启通知监听权限」授权\n3. 收款通知会自动转发到服务器\n\n注意：\n- 请关闭电池优化，防止后台被杀\n- 支付宝和微信收款通知都会自动捕获"
                android:textSize="13sp"
                android:textColor="#666"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>

        <!-- 版本号 -->
        <TextView
            android:id="@+id/tv_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="v1.0"
            android:textSize="12sp"
            android:textColor="#BBB"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp"/>

    </LinearLayout>

</ScrollView>
